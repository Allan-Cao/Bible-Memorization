// Cloudflare Workers static assets: the site is files only, with no Worker script.
// Deploy with `npm run build && npx wrangler deploy`.
{
	"name": "bible-memorization",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./build",
		// Unknown paths get build/404.html (the app shell, which shows "Not found").
		// Deck pages are rewritten to it with status 200 by static/_redirects.
		"not_found_handling": "404-page"
	}
}
